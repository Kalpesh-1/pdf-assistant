# ---------------------------------------------------------------------------
# PDF Assistant - example configuration
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#
# The real ".env" file stays on your machine. Never share it and never put a
# real API key in this example file.
# ---------------------------------------------------------------------------

# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# The Groq chat model used for answers, summaries and explanations.
#
# Groq retires models from time to time. If you get a "model not found" error,
# check the current list at https://console.groq.com/docs/models.
#
# Other models confirmed working on 2026-11-01:
#   openai/gpt-oss-20b   - smaller and faster, slightly weaker answers
#   qwen/qwen3.8-27b     - answers directly, uses the fewest tokens per reply
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model, downloaded once from Hugging Face and then cached.
# This runs on your own machine, so it costs nothing to use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# How the PDF text is split before it is embedded.
# CHUNK_SIZE    = characters per chunk
# CHUNK_OVERLAP = characters repeated between neighbouring chunks, so a
#                 sentence sitting on a chunk border is not lost
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# How many chunks are retrieved from the vector index for each question.
TOP_K=4

# Similarity score threshold (0.0 to 1.0). Chunks scoring below this are ignored,
# even if they rank in the top K. When no chunks clear this floor, the assistant
# abstains rather than guessing.
#
# Lower values (e.g. 0.1) retrieve more chunks but risk irrelevant matches.
# Higher values (e.g. 0.5) retrieve fewer chunks but only very confident matches.
# The default (0.25) balances recall and precision for typical RAG use cases.
MIN_SIMILARITY=0.25

# Largest PDF the application will accept, in megabytes.
MAX_UPLOAD_SIZE_MB=20
